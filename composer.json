{
  "name": "own/phinanse-api",
  "description": "Phinanse API",
  "type": "project",
  "require": {
    "php": ">=8.5",
    "ext-pdo": "*",
    "psr/http-message": "^2.0",
    "psr/container": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "symfony/var-dumper": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "Shepherdmat\\Phinanse\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Shepherdmat\\Phinanse\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
